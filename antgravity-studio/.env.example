# ==========================================
# Configurações Globais e Servidor
# ==========================================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# ==========================================
# Banco de Dados e Cache
# ==========================================
DATABASE_URL=postgresql://antgravity_user:antgravity_password@localhost:5432/antgravity_db?schema=public
REDIS_URL=redis://localhost:6379

# ==========================================
# Autenticação e Segurança
# ==========================================
JWT_SECRET=sua_chave_secreta_jwt_super_segura_substitua_em_producao
JWT_EXPIRES_IN=7d

# ==========================================
# Integrações de IA e Provedores Cloud
# ==========================================
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui
GOOGLE_CLOUD_API_KEY=AIzaSy_sua_chave_google_cloud_aqui
ANTGRAVITY_API_KEY=ag_live_sua_chave_antgravity_aqui

# ==========================================
# Provedores de Mídia e Assets
# ==========================================
PIXABAY_API_KEY=sua_chave_pixabay_aqui
PEXELS_API_KEY=sua_chave_pexels_aqui

# ==========================================
# Armazenamento e Upload (S3 / Cloudinary / Local)
# ==========================================
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=sua_aws_access_key
AWS_SECRET_ACCESS_KEY=sua_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=antgravity-studio-assets
