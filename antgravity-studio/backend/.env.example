# Configurações Específicas do Backend Express API
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Conexões de Infraestrutura
DATABASE_URL=postgresql://antgravity_user:antgravity_password@postgres:5432/antgravity_db?schema=public
REDIS_URL=redis://redis:6379

# Autenticação
JWT_SECRET=sua_chave_secreta_jwt_backend
JWT_EXPIRES_IN=7d

# Provedores de Serviços de IA
OPENAI_API_KEY=sk-proj-sua_chave_openai_backend
GOOGLE_CLOUD_API_KEY=AIzaSy_sua_chave_google_cloud_backend
ANTGRAVITY_API_KEY=ag_live_sua_chave_antgravity_backend

# Provedores de Mídia Externa
PIXABAY_API_KEY=sua_chave_pixabay_backend
PEXELS_API_KEY=sua_chave_pexels_backend
